{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Backend.API - Swagger",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build Backend.API",
			"program": "${workspaceFolder}/Backend/Backend.API/bin/Debug/net10.0/Backend.API.dll",
			"cwd": "${workspaceFolder}/Backend/Backend.API",
			"console": "internalConsole",
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_URLS": "http://localhost:5000"
			},
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "\\bNow listening on:\\s+(https?://\\S+)",
				"uriFormat": "%s/swagger"
			}
		}
	]
}
