{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/VocabularyModule/Vocabulary.API/Vocabulary.API.csproj",
				"-c",
				"Debug"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "stop-api",
			"type": "shell",
			"command": "echo Debug session ended",
			"problemMatcher": []
		}
	]
}
